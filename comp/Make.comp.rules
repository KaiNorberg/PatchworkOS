OBJ = $(patsubst $(SRC_DIR)/%, $(COMP_BUILD_DIR)/%.o, $(SRC))

DEP = $(OBJ:.o=.d)
-include $(DEP)

COMP_DEP_BUILT = $(foreach dep,$(COMP_DEPENDS),$(BIN_DIR)/.$(dep).built)

ifeq ($(COMP_TYPE),data)
TARGET :=
SRC :=
STAGE_DEST := $(STAGE_DIR)/
endif

ifneq ($(SRC),)
$(COMP_BUILD_DIR)/%.c.o: $(SRC_DIR)/%.c
	$(MKCWD)
	@echo "  CC    $<"
	@$(CC) $(CFLAGS) -MMD -MP -MF $(@:.o=.d) -c -o $@ $<

$(COMP_BUILD_DIR)/%.S.o: $(SRC_DIR)/%.S
	$(MKCWD)
	@echo "  AS    $<"
	@$(AS) $(ASFLAGS) -MMD -MP -MF $(@:.o=.d) -c -o $@ $<
endif

ifeq ($(COMP_TYPE),executable)
TARGET = $(COMP_BIN_DIR)/$(COMP_NAME)
$(TARGET): $(OBJ) $(COMP_DEP_BUILT)
	$(MKCWD)
	@echo "  LD    $@"
	@$(CC) -nostdlib $(USER_CFLAGS) -o $@ $(CRT_START) $(OBJ) $(LDFLAGS) -lc -Wl,-dynamic-linker=/lib/dynlink.so $(CRT_END)
STAGE_DEST = $(STAGE_DIR)/bin/
endif

ifeq ($(COMP_TYPE),module)
TARGET = $(COMP_BIN_DIR)/$(COMP_NAME).ko
$(TARGET): $(OBJ) $(COMP_DEP_BUILT)
	$(MKCWD)
	@echo "  LD-KO $@"
	@$(LD) -o $@ $(OBJ) $(LDFLAGS)
STAGE_DEST = $(STAGE_DIR)/mod/
endif

ifeq ($(COMP_TYPE),static)
TARGET = $(COMP_BIN_DIR)/$(COMP_NAME).a
$(TARGET): $(OBJ) $(COMP_DEP_BUILT)
	$(MKCWD)
	@echo "  AR    $@"
	@$(AR) rcs $@ $(OBJ)
STAGE_DEST = $(STAGE_DIR)/lib/
endif

ifeq ($(COMP_TYPE),shared)
TARGET = $(COMP_BIN_DIR)/$(COMP_NAME).so
$(TARGET): $(OBJ) $(COMP_DEP_BUILT)
	$(MKCWD)
	@echo "  LD-SO $@"
	@$(LD) -shared -soname $(COMP_NAME).so -o $@ $(OBJ) $(LDFLAGS) $(LDSTDLIB)
STAGE_DEST = $(STAGE_DIR)/lib/
endif

ifeq ($(COMP_TYPE),static-shared)
TARGET = $(COMP_BIN_DIR)/$(COMP_NAME).a $(COMP_BIN_DIR)/$(COMP_NAME).so
$(COMP_BIN_DIR)/$(COMP_NAME).a: $(OBJ) $(COMP_DEP_BUILT)
	$(MKCWD)
	@echo "  AR    $@"
	@$(AR) rcs $@ $(OBJ)
$(COMP_BIN_DIR)/$(COMP_NAME).so: $(OBJ) $(COMP_DEP_BUILT)
	$(MKCWD)
	@echo "  LD-SO $@"
	@$(LD) -shared -soname $(COMP_NAME).so -o $@ $(OBJ) $(LDFLAGS) $(LDSTDLIB)
STAGE_DEST = $(STAGE_DIR)/lib/
endif

ifeq ($(COMP_TYPE),port)
PORT_TARGET = $(COMP_BUILD_DIR)/.port.built
TARGET :=
SRC :=
STAGE_DEST := $(STAGE_DIR)/

$(PORT_TARGET): | $(COMP_DEP_BUILT)
	$(MKCWD)
	@mkdir -p $(STAGE_DIR)
	@echo "  PORT  $(COMP_NAME)"
	$(PORT_BUILD_CMD)
	@touch $@
before-target: $(PORT_TARGET)
endif

all: before-target $(TARGET) before-stage stage after-stage

stage:
	@echo "  STAGE $(COMP_NAME) $(COMP_VERSION)"
	@mkdir -p $(STAGE_DEST)
ifneq ($(TARGET),)
	@cp $(TARGET) $(STAGE_DEST)
endif
ifeq ($(COMP_TYPE),port)
	$(PORT_STAGE_CMD)
endif
ifneq ($(COMP_DEVICES),)
	@for dev in $(COMP_DEVICES); do \
	    mkdir -p $(STAGE_BY_DEVICE_DIR)/$$dev; \
		ln -sf /comp/$(COMP_NAME)/$(COMP_VERSION) $(STAGE_BY_DEVICE_DIR)/$$dev/$(COMP_NAME); \
	done
endif

	@cat $(MY_DIR)/manifest.scon > $(STAGE_DIR)/manifest.scon

	@if [ -d "$(MY_DIR)/share" ]; then \
		cp -r $(MY_DIR)/share $(STAGE_DIR)/share; \
	fi
	@if [ -d "$(MY_DIR)/include" ]; then \
		cp -r $(MY_DIR)/include $(STAGE_DIR)/include; \
	fi
	
	@if [ -d "$(STAGE_DIR)/include" ]; then \
		cp -r $(STAGE_DIR)/include/* $(STAGING_DIR)/include/ 2>/dev/null || true; \
	fi
	@if [ -d "$(STAGE_DIR)/lib" ]; then \
		mkdir -p $(STAGING_DIR)/lib; \
		cp -r $(STAGE_DIR)/lib/* $(STAGING_DIR)/lib/ 2>/dev/null || true; \
		cp -P $(STAGE_DIR)/lib/*.so* $(COMP_BIN_DIR)/ 2>/dev/null || true; \
		cp -P $(STAGE_DIR)/lib/*.a $(COMP_BIN_DIR)/ 2>/dev/null || true; \
	fi

.PHONY: before-target before-stage after-stage
before-target:
before-stage:
after-stage:

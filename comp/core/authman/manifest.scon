(component
    (description "Authentication Manager.")
    (author "Kai Norberg")
    (license MIT)
    (launch /bin/authman)
    (dependencies
        (libc 1.0.0)
        (libm 1.0.0)
        (zlib 1.0.0)
        (libgfx 1.0.0)
        (libgui 1.0.0)
        (freetype 1.0.0)
        (libpng 1.0.0)
    )
    (capabilities
        /dev/fb
    )
)
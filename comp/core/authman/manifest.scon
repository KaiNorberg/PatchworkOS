(component
    (description "Authentication Manager.")
    (author "Kai Norberg")
    (license GPLv3)
    (launch /bin/authman)
    (dependencies
        (libc 1.0.0)
        (libm 1.0.0)
        (zlib 1.0.0)
        (libgfx 1.0.0)
        (libgui 1.0.0)
        (freetype 1.0.0)
        (libpng 1.0.0)
        (default_cursors 1.0.0)
        (default_icons 1.0.0)
        (default_wallpaper 1.0.0)
    )
    (capabilities
        /dev/fb
        /dev/kbd
        /dev/mouse
    )
)
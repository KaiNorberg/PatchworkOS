[exec]
bin = /app/bin/wall
priority = 30

[sandbox]
profile = empty
foreground = false

[env]

[namespace]
/app:rx = $BOX
/cfg:r = /cfg
/base:rwcd = 
/base/data:r = /base/data
/net:rw = /net
/dev:rwcd = 
/dev/const:rw = /dev/const
/dev/klog:rw = /dev/klog

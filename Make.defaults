CC := clang --config $(ROOT_DIR)/tools/patchworkos.cfg
AS := clang --config $(ROOT_DIR)/tools/patchworkos.cfg
LD := ld.lld
AR := llvm-ar
RANLIB := llvm-ranlib
OBJCOPY := llvm-objcopy
MKCWD = @mkdir -p $(@D)

CC_INC := $(shell clang -print-file-name=include)

CFLAGS += \
	-std=gnu11 \
	-ffreestanding \
	-march=x86-64 \
	-fno-pie \
	-fno-stack-protector \
	-fcf-protection=none \
	-mno-red-zone \
	-nostdinc \
	-Wall \
	-Wextra \
	-Werror \
	-Wno-pragmas \
	-Wno-unused-function \
	-Wno-unused-variable \
	-Wno-ignored-qualifiers \
	-Wno-unused-but-set-variable \
	-Wno-implicit-fallthrough \
	-Wno-unused-but-set-parameter \
	-Wno-unused-parameter \
	-Wno-missing-braces \
	-Wno-override-init \
	-Wno-unused-command-line-argument \
	-isystem $(STAGING_DIR)/include \
	-isystem $(CC_INC)

CFLAGS_DISABLE_SIMD += \
	-mno-mmx -mno-3dnow \
	-mno-80387 -mno-sse \
	-mno-sse2 -mno-sse3 \
	-mno-ssse3 -mno-sse4 \
	-mno-avx -mno-avx2

ASFLAGS += \
  	-nostdinc \
	-ffreestanding \
	-Wno-unused-command-line-argument \
	-isystem $(STAGING_DIR)/include \
	-isystem $(CC_INC)

LDFLAGS +=

ifeq ($(TESTING),1)
	CFLAGS += -D_TESTING_
	ASFLAGS += -D_TESTING_
endif

ifeq ($(DEBUG),1)
	CFLAGS += -O0 -g3 -ggdb -fno-omit-frame-pointer -fno-inline
	LDFLAGS += -g
else
	CFLAGS += -O2 -DNDEBUG
endif

CRT_START += $(BIN_DIR)/comp/crt0.o $(BIN_DIR)/comp/crti.o
CRT_END += $(BIN_DIR)/comp/crtn.o
